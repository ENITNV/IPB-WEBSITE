# Contact form settings — set these as Environment variables in Dokploy.
# Never commit a real .env file.

# Where consultation requests are delivered (Yael's inbox). Comma-separate for more than one.
CONTACT_TO=yael@example.com

# SMTP account that sends the notification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=website@example.com
SMTP_PASSWORD=app-password-here
SMTP_FROM=website@example.com
